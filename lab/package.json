{
  "name": "agent-ecology-lab",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --no-warnings --test test/*.test.ts",
    "rule": "node --experimental-strip-types --no-warnings scripts/run-rule.ts",
    "schelling": "node --experimental-strip-types --no-warnings scripts/run-schelling.ts",
    "cascade": "node --experimental-strip-types --no-warnings scripts/run-cascade.ts",
    "el-farol": "node --experimental-strip-types --no-warnings scripts/run-el-farol.ts",
    "analyse": "node --experimental-strip-types --no-warnings scripts/analyse.ts",
    "habit": "node --experimental-strip-types --no-warnings scripts/run-habit.ts",
    "figures": "node --experimental-strip-types --no-warnings scripts/figures.ts"
  },
  "dependencies": {
    "@mlc-ai/web-llm": "^0.2.85"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "playwright-core": "^1.57.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  }
